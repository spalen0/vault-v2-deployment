# =============================================================================
# Katana mainnet — Yearn OG V2 vault deployment template
# =============================================================================
# Copy to `.env`, then uncomment ONE of the two per-vault blocks at the bottom
# (ETH vault OR USDC vault) before running:
#
#   forge script script/DeployVaultV2WithMarketAdapterFromV1.s.sol:DeployVaultV2WithMarketAdapterFromV1 \
#     --sig "run()" --rpc-url https://rpc.katana.network --ledger --sender $OWNER \
#     --broadcast --slow
#
# For full step-by-step instructions see docs/deploy_katana_vaults.md.
# =============================================================================

# -----------------------------------------------------------------------------
# Roles
# -----------------------------------------------------------------------------
OWNER=0x518C21DC88D9780c0A1Be566433c571461A70149
CURATOR=0x90D0f26025571295D18a6c041E47450B81886B51
ALLOCATOR=0x75a1253432356f90611546a487b5350CEF08780D
SENTINEL=0xe6ad5A88f5da0F276C903d9Ac2647A937c917162
ADDITIONAL_ALLOCATOR=0x50B75d586929Ab2F75dC15f07E1B921b7C4Ba8fA   # tapir

# -----------------------------------------------------------------------------
# Shared parameters (same for both vaults)
# -----------------------------------------------------------------------------
# Morpho V2 infrastructure on Katana
ADAPTER_REGISTRY=0xA9132a09838fD20304dF2B2892679d06A4cc6371
VAULT_V2_FACTORY=0xFcb8b57E56787bB29e130Fca67f3c5a1232975D1
MORPHO_MARKET_V1_ADAPTER_V2_FACTORY=0x6d6A3ba62836d6B40277767dCAc8fd390d4BcedC

# Timelocks (Morpho listing minima: 7d vault / 3d adapter)
VAULT_TIMELOCK_DURATION=604800
ADAPTER_TIMELOCK_DURATION=259200

# 100% max annual rate (per-second scaled)
MAX_RATE=31709791983

# NAME and SYMBOL left blank on purpose: the script falls back to the source V1
# vault's name()/symbol() so the V2 inherits e.g. "Yearn OG ETH" / "yOG-ETH".
# NAME=
# SYMBOL=

# Safety bound when iterating V1 withdrawQueue (default 50 if unset).
# MAX_MARKETS=50

# =============================================================================
# Pick ONE of the two blocks below — uncomment and leave the other commented.
# =============================================================================

# -----------------------------------------------------------------------------
# [A] Yearn OG ETH V2 on Katana
# -----------------------------------------------------------------------------
# ASSET=0xEE7D8BCFb72bC1880D0Cf19822eB0A2e6577aB62                     # vbETH (18 dec)
# VAULT_V1=0xFaDe0C546f44e33C134c4036207B314AC643dc2E                   # Yearn OG ETH V1
# LIQUIDITY_COLLATERAL_TOKEN=0x9893989433e7a383Cb313953e4c2365107dc19a7 # weETH (ETH→weETH rule)
# ADAPTER_ABSOLUTE_CAP=30000000000000000000000                          # 30,000 vbETH (~$100M)
# DEAD_DEPOSIT_AMOUNT=1000000000                                        # 1 gwei of vbETH

# -----------------------------------------------------------------------------
# [B] Yearn OG USDC V2 on Katana
# -----------------------------------------------------------------------------
# ASSET=0x203A662b0BD271A6ed5a60EdFbd04bFce608FD36                     # vbUSDC (6 dec)
# VAULT_V1=0xCE2b8e464Fc7b5E58710C24b7e5EBFB6027f29D7                   # Yearn OG USDC V1
# LIQUIDITY_COLLATERAL_TOKEN=0xEE7D8BCFb72bC1880D0Cf19822eB0A2e6577aB62 # vbETH (USDC→ETH rule)
# ADAPTER_ABSOLUTE_CAP=100000000000000                                  # 100M USDC
# DEAD_DEPOSIT_AMOUNT=1000000                                           # $1 (1 USDC)
